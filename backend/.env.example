# ==========================================
# Salon Queue Management System - Backend Environment
# ==========================================

# Port (Render sets this automatically, default 5000 for local dev)
PORT=5000

# Environment mode ('development' or 'production')
NODE_ENV=production

# Allowed Frontend Origins for CORS (comma-separated or wildcard '*')
# Example for production: https://your-salon-frontend.vercel.app
FRONTEND_URL=*

# SQLite Storage (Persistent Disk for Render or local storage)
# For Render Persistent Disk mounted at /var/data:
DATA_DIR=/var/data
DATABASE_PATH=/var/data/salon.sqlite
